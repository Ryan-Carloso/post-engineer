{
  "format": ["typescript", "tsx", "javascript", "python"],
  "path": ["apps/web", "apps/mcp", "shared", "scripts", ".github/scripts"],
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.next/**",
    "**/.venv/**",
    "**/coverage*/**",
    "**/.stryker-tmp/**",
    "**/mutants/**",
    "**/__tests__/**",
    "**/test/**",
    "**/tests/**",
    "**/*.test.*",
    "**/*.spec.*",
    "**/cypress/**",
    "**/*.gen.ts",
    "**/lib/contracts/**",
    "**/src/contracts/**"
  ],
  "gitignore": true,
  "minLines": 10,
  "minTokens": 100,
  "absolute": true
}
