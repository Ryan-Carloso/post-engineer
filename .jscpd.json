{
    "format": [
        "typescript",
        "javascript",
        "python"
    ],
    "ignore": [
        "**/node_modules/**",
        "**/dist/**",
        "**/__tests__/**",
        "**/test/**",
        "**/*.test.*",
        "**/*.spec.*",
        "**/*.md",
        "docs/**",
        "**/*.lock",
        "**/*.snap",
        "**/*.snap.*"
    ],
    "minLines": 50,
    "minTokens": 100,
    "path": [
        "apps/web",
        "apps/mcp",
        "apps/engine"
    ],
    "reporters": [
        "consoleFull"
    ],
    "threshold": 0
}
