# OAuth 2.0 Credential (Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
API_KEY=

# OAuth Redirect URI
# IMPORTANT: These redirect_uris MUST be registered in Google Cloud Console!
# Add them in: APIs & Services → Credentials → Edit OAuth 2.0 Client → Authorized redirect URIs
GOOGLE_REDIRECT_URI=
GOOGLE_REDIRECT_URI_LOCAL=

# Instagram OAuth Credentials (Instagram API with Instagram Login)
# Get them at: https://developers.facebook.com/apps (Business app with the Instagram product)
# The app needs the instagram_business_basic and instagram_business_content_publish permissions
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=
INSTAGRAM_REDIRECT_URI_LOCAL=

# Supabase Credentials
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key (server-only). Never expose in NEXT_PUBLIC_.
# Found at: Supabase Dashboard → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=

# OAuth token encryption (AES-256-GCM)
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Money-print engine
MONEYPRINT_API_URL=
# Shared secret web <-> engine (identical to apps/engine/.env)
MONEYPRINT_API_SECRET=
NEXT_PUBLIC_APP_URL=
MCP_RESOURCE=

# LinkedIn OAuth Credentials
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=
LINKEDIN_REDIRECT_URI_LOCAL=

# PostHog (error tracking, analytics, feature flags)
# Project API key — write-only, safe for NEXT_PUBLIC_ (client-side use).
# Get it at: PostHog dashboard → Project Settings → Project token (phc_...)
NEXT_PUBLIC_POSTHOG_KEY=
# PostHog host (defaults to DEFAULT_POSTHOG_HOST in lib/posthog-config.ts if unset).
# Our project is on EU Cloud; set this only for a different region or self-host.
NEXT_PUBLIC_POSTHOG_HOST=
# Server-side key (optional). Falls back to NEXT_PUBLIC_POSTHOG_KEY when unset.
POSTHOG_API_KEY=

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_PRICE_PACK_10=
STRIPE_PRICE_PACK_50=
STRIPE_PRICE_PACK_100=
STRIPE_WEBHOOK_SECRET=

# MCP OAuth signing key (PEM, \n-escaped)
MCP_OAUTH_PRIVATE_KEY_PEM=

# Cypress e2e test credentials
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=
