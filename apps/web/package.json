{
  "name": "Post-Engineer",
  "version": "1.21.3",
  "private": true,
  "description": "Post Engineer API - Next.js with enhanced error logging and timeout management",
  "main": "src/api/server.js",
  "scripts": {
    "dev": "next dev -p 3434",
    "build": "next build",
    "start": "next start",
    "lint": "pnpm exec eslint lib/ app/",
    "lint:fix": "pnpm exec eslint --fix lib/ app/",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:unit": "vitest run",
    "test:e2e": "cypress run",
    "test:e2e:open": "cypress open",
    "test:e2e:coverage": "start-server-and-test 'CYPRESS_COVERAGE=1 TESTING=1 next dev -p 3434' http://localhost:3434/login 'CYPRESS_COVERAGE=1 cypress run' && node scripts/print-coverage.js",
    "test:e2e:coverage:open": "start-server-and-test 'CYPRESS_COVERAGE=1 TESTING=1 next dev -p 3434' http://localhost:3434/login 'CYPRESS_COVERAGE=1 cypress open'",
    "test:coverage": "vitest run --coverage && node scripts/print-coverage.js",
    "test:all": "vitest run --coverage && npm run test:e2e:coverage"
  },
  "keywords": [
    "youtube",
    "api",
    "upload",
    "video",
    "oauth2"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@atproto/api": "^0.20.44",
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-aspect-ratio": "^1.1.15",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "posthog-js": "^1.300.0",
    "posthog-node": "^5.54.1",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@vercel/analytics": "^2.0.1",
    "axios": "^1.19.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "google-auth-library": "^10.9.1",
    "googleapis": "^126.0.1",
    "jose": "^6.2.12",
    "lucide-react": "^1.42.0",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.88.0",
    "react-icons": "^5.7.0",
    "server-only": "^0.0.1",
    "stripe": "^22.6.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@cypress/code-coverage": "^3",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@next/env": "^16.3.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.10.5",
    "@types/react": "19.2.18",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "@vitest/coverage-v8": "^4.1.11",
    "babel-plugin-istanbul": "^8.0.0",
    "cypress": "^13.17.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.23",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "globals": "^17.12.0",
    "jest": "^29.7.0",
    "jsdom": "^30.0.1",
    "knip": "^6.32.2",
    "start-server-and-test": "^3.0.12",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11"
  }
}
