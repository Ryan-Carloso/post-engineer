{
  "name": "Post-Engineer",
  "version": "1.28.0",
  "private": true,
  "description": "Post Engineer API - Next.js with enhanced error logging and timeout management",
  "main": "src/api/server.js",
  "scripts": {
    "dev": "next dev -p 3434",
    "build": "next build",
    "start": "next start",
    "lint": "pnpm exec eslint lib/ app/",
    "lint:fix": "pnpm exec eslint --fix lib/ app/",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:unit": "vitest run",
    "test:e2e": "cypress run",
    "test:e2e:open": "cypress open",
    "test:e2e:coverage": "start-server-and-test 'CYPRESS_COVERAGE=1 TESTING=1 next dev -p 3434' http://localhost:3434/login 'CYPRESS_COVERAGE=1 cypress run' && node scripts/print-coverage.js",
    "test:e2e:coverage:open": "start-server-and-test 'CYPRESS_COVERAGE=1 TESTING=1 next dev -p 3434' http://localhost:3434/login 'CYPRESS_COVERAGE=1 cypress open'",
    "test:coverage": "vitest run --coverage && node scripts/print-coverage.js",
    "test:all": "vitest run --coverage && npm run test:e2e:coverage",
    "prebuild": "pnpm --filter post-engineer-mcp build && node ../../scripts/sync-script-segments.mjs",
    "predev": "pnpm --filter post-engineer-mcp build",
    "pretest": "pnpm --filter post-engineer-mcp build && node ../../scripts/sync-script-segments.mjs"
  },
  "keywords": [
    "youtube",
    "api",
    "upload",
    "video",
    "oauth2"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@atproto/api": "^0.20.44",
    "@hiveio/dhive": "^1.3.6",
    "@hookform/resolvers": "^5.9.2",
    "@radix-ui/react-aspect-ratio": "^1.2.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@tanstack/react-query": "^5.107.1",
    "@vercel/analytics": "^2.0.1",
    "axios": "^1.21.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "google-auth-library": "^10.9.1",
    "googleapis": "^126.0.1",
    "jose": "^6.2.17",
    "lucide-react": "^1.72.0",
    "next": "^15.5.29",
    "next-themes": "^0.4.6",
    "post-engineer-mcp": "workspace:*",
    "posthog-js": "^1.447.15",
    "posthog-node": "^5.70.0",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-icons": "^5.7.0",
    "recharts": "^2.15.4",
    "server-only": "^0.0.1",
    "stripe": "^22.6.2",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@cypress/code-coverage": "^3.14.7",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@next/env": "^16.4.6",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.43",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "@vitest/coverage-v8": "^4.1.12",
    "babel-plugin-istanbul": "^8.0.0",
    "cypress": "^13.17.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.29",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "globals": "^17.14.0",
    "jest": "^29.7.0",
    "jsdom": "^30.1.3",
    "knip": "^6.45.1",
    "openapi-typescript": "^7.13.0",
    "start-server-and-test": "^3.0.13",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^4.1.12"
  }
}
