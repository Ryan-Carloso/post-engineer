# Shared secret web <-> engine (must be IDENTICAL to apps/web/.env)
MONEYPRINT_API_SECRET=

# Task state backend: memory (in-process, no external dependency)

# Internal publish API
MPT_UPLOAD_API_BASE_URL=
MPT_REMOTE_PUBLISH=

# Fill Schedule (scheduler in-process — starts with the app)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Discord notifications for the fill schedule
DISCORD_WEBHOOK_URL=

# Video archive backend for final videos (app/services/video_storage.py).
# Leave MPT_VIDEO_STORAGE unset (or "supabase") to keep archiving to Supabase
# Storage. Note the Supabase Free plan caps a single object at ~50 MB and the
# bucket limit cannot be raised through the API, so longer 1080x1920 renders
# fail to archive (best-effort, logged, never fails the task).
#
# Set to "r2" to archive to Cloudflare R2 instead: S3-compatible, 5 GB per
# object, 10 GB free, no egress fees. Create an Account API Token with
# Object Read & Write scoped to the bucket; the account id is the segment in
# the dashboard URL: dash.cloudflare.com/<R2_ACCOUNT_ID>/r2/...
# MPT_VIDEO_STORAGE=r2
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# Modal app name for the InfiniteTalk endpoints (modal_app.py builds
# STATUS/DOWNLOAD endpoint URLs from this; required when using modal_app.py)
INFINITETALK_MODAL_APP_NAME=

# Bearer secret required by the InfiniteTalk Modal HTTP endpoints.
# Must match the [infinitetalk] http_secret in config.toml and the secret
# deployed via: modal secret create infinitetalk-http INFINITETALK_HTTP_SECRET=...
INFINITETALK_HTTP_SECRET=
