# Shared secret web <-> engine (must be IDENTICAL to apps/web/.env)
MONEYPRINT_API_SECRET=

# Task state backend: memory (in-process, no external dependency)

# Internal publish API
MPT_UPLOAD_API_BASE_URL=
MPT_REMOTE_PUBLISH=

# Bugsink (error tracking, Sentry-compatible)
BUGSINK_DSN=

# Fill Schedule (scheduler in-process — starts with the app)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Discord notifications for the fill schedule
DISCORD_WEBHOOK_URL=

# Modal app name for the InfiniteTalk endpoints (modal_app.py builds
# STATUS/DOWNLOAD endpoint URLs from this; required when using modal_app.py)
INFINITETALK_MODAL_APP_NAME=

# Bearer secret required by the InfiniteTalk Modal HTTP endpoints.
# Must match the [infinitetalk] http_secret in config.toml and the secret
# deployed via: modal secret create infinitetalk-http INFINITETALK_HTTP_SECRET=...
INFINITETALK_HTTP_SECRET=
