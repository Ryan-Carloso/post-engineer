# Shared secret web <-> engine (must be IDENTICAL to apps/web/.env)
MONEYPRINT_API_SECRET=

# Internal publish API (the web app the publisher posts to)
MPT_UPLOAD_API_BASE_URL=

# Publish scheduler (in-process — starts with the app)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Discord notifications for the publish scheduler
DISCORD_WEBHOOK_URL=

# Owner failure email (Resend). Same two variables as apps/web/.env.
# The engine emails when a post fails to publish.
# Leave both empty to disable. Quote ACCOUNT_BREAK_FROM.
# ACCOUNT_BREAK_FROM="Post Engineer <alerts@notifications.post-engineer.com>"
RESEND_API_KEY=
ACCOUNT_BREAK_FROM=

# PostHog telemetry (warn-and-continue when unset)
POSTHOG_API_KEY=
