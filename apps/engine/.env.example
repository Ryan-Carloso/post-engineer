# Shared secret web <-> engine (must be IDENTICAL to apps/web/.env)
MONEYPRINT_API_SECRET=

# Task state backend: memory (in-process, no external dependency)

# Internal publish API
MPT_UPLOAD_API_BASE_URL=
MPT_REMOTE_PUBLISH=

# Fill Schedule (scheduler in-process — starts with the app)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Discord notifications for the fill schedule
DISCORD_WEBHOOK_URL=

# Video archive for final videos — Cloudflare R2 is mandatory. Create an
# Account API Token with Object Read & Write scoped to the `videos` bucket;
# the account id is the segment in dash.cloudflare.com/<R2_ACCOUNT_ID>/r2/...
# The engine refuses to generate/archive videos if any of these are missing.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# MIGRATING from InfiniteTalk: these five variables were renamed INFINITETALK_*.
# There is deliberately NO fallback for the old names — a half-migrated
# deployment must fail loudly ("LongCat submit_url is not configured
# (LONGCAT_SUBMIT_URL)") rather than silently keep rendering intros nobody can
# download. Rename them in Infisical (env=dev and env=prod), in apps/engine/.env,
# and re-run `modal deploy modal_longcat.py` (the app name moved from
# moneyprint-infinitetalk to moneyprint-longcat, so the endpoint URLs change too)
# in the same rollout, BEFORE deploying this build. Same for the `[longcat]`
# section in config.toml, which was `[infinitetalk]`.

# Modal app name for the LongCat lip-sync endpoints (modal_longcat.py builds
# STATUS/DOWNLOAD endpoint URLs from this; required to deploy or run that app)
LONGCAT_MODAL_APP_NAME=

# LongCat Modal HTTP workflow — per environment (dev and prod use
# separate Modal accounts). The URLs come from the `modal deploy` output of
# the LongCat app in each account.
LONGCAT_SUBMIT_URL=
LONGCAT_STATUS_URL=
LONGCAT_DOWNLOAD_URL=

# Bearer secret required by the LongCat Modal HTTP endpoints.
# Must match the secret deployed in the same Modal account via:
#   modal secret create longcat-http LONGCAT_HTTP_SECRET=...
LONGCAT_HTTP_SECRET=
