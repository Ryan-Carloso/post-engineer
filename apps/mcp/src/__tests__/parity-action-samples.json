  "check_script.validate": [
    {
      "args": {
        "action": "validate",
        "segments": [
          {
            "kind": "hook",
            "text": "Most people burn out because they train every single day without any plan, and here is the simple weekly structure that fixes it for good."
          },
          {
            "kind": "content",
            "text": "Start with three focused sessions a week, each one built around a single goal, so your body can recover and your progress keeps moving forward instead of stalling."
          },
          {
            "kind": "content",
            "text": "Track every session in a simple notebook, review it on Sunday, and change only one thing at a time, because small and steady adjustments beat dramatic restarts."
          }
        ],
        "videoType": "full_lipsync"
      }
    }
  ],
