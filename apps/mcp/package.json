{
  "name": "post-engineer-mcp",
  "version": "1.18.0",
  "engines": {
    "node": ">=20.10"
  },
  "type": "module",
  "description": "Post Engineer MCP Server for AI pair programming and agentic workflows",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "post-engineer-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "pnpm build",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.spec.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "posthog-node": "^5.54.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ryan-Carloso/post-engineer.git",
    "directory": "apps/mcp"
  }
}
