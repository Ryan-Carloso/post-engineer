{
  "name": "post-engineer-mcp",
  "mcpName": "io.github.Ryan-Carloso/post-engineer",
  "version": "1.52.0",
  "engines": {
    "node": ">=20.10"
  },
  "type": "module",
  "description": "Post Engineer MCP Server for AI pair programming and agentic workflows",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "post-engineer-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "pnpm build",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.spec.json",
    "prebuild": "node ../../scripts/sync-script-segments.mjs",
    "pretest": "node ../../scripts/sync-script-segments.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "jose": "^6.2.17",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "^20.19.43",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^4.1.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ryan-Carloso/post-engineer.git",
    "directory": "apps/mcp"
  }
}
