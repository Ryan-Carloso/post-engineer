# Block direct commits to main/master/prod (mirrors .githooks/pre-commit)
branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
case "$branch" in main|master|prod)
  echo "[git-protect] BLOCKED: direct commit to '$branch' is forbidden."
  echo "[git-protect] Create a working branch and merge/PR afterwards."
  exit 1 ;;
esac

# NOTE (2026-10-06): the old `pnpm lint:fix` step was removed — the full-repo
# eslint --fix + typecheck across all apps OOMs on smaller machines and CI
# already runs the complete lint/typecheck suite on every PR. Run lint and
# typecheck for your changed files before committing instead.
exit 0
